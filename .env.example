APP_NAME="YCC Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Subfolder in public_html:  APP_URL=https://conservems.my/ycc-hub  (and SESSION_PATH=/ycc-hub below)
# Subdomain:                  APP_URL=https://ycc.conservems.my     (and SESSION_PATH=/)
APP_URL=https://conservems.my/ycc-hub
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanel MySQL (cPanel prefixes names with your account, e.g. cpuser_ycchub)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_ycchub
DB_USERNAME=cpuser_ycchub
DB_PASSWORD=
DB_TIMEZONE=+08:00

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/ycc-hub
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Mail (approval emails, password reset)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.conservems.my
MAIL_PORT=587
MAIL_USERNAME=noreply@conservems.my
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@conservems.my"
MAIL_FROM_NAME="${APP_NAME}"

# Activity rules (days)
YCC_ACTIVE_DAYS=60
YCC_AT_RISK_DAYS=90
YCC_GRACE_DAYS=60
YCC_ATTENDANCE_LOCK_DAYS=14

# Social links (can also be changed in Admin > Settings)
YCC_INSTAGRAM_HANDLE=young.conservationist
YCC_INSTAGRAM_URL=https://www.instagram.com/young.conservationist/
YCC_LINKEDIN_URL=https://www.linkedin.com/company/young-conservationist-club/

# Optional: long-lived Instagram token (Admin > Settings is easier and overrides this)
INSTAGRAM_ACCESS_TOKEN=

# One-time web installer. Set a long random value, open /install, then DELETE this line.
INSTALL_KEY=

VITE_APP_NAME="${APP_NAME}"
